NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://lyricsflip:lyricsflip@localhost:5432/lyricsflip
DB_MIGRATIONS_RUN=true

# Redis (also used for the throttler's storage and wallet-auth challenges)
REDIS_HOST=localhost
REDIS_PORT=6379
# Full connection URL, used where a single URL is expected instead of host/port.
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_TOKEN_AUDIENCE=localhost:4000
JWT_TOKEN_ISSUER=localhost:4000
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=7776000

# Rate limiting (common/throttler) - global default window/limit.
# RATE_LIMIT_TTL is in milliseconds; /auth/* and answer submission apply
# their own stricter, non-configurable limits.
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=60

# CORS - comma-separated list of allowed origins, or `*` for all.
CORS_ORIGINS=http://localhost:3000

# Email (Mailpit in docker compose: host=localhost, port=1025, no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LyricsFlip <no-reply@lyricsflip.local>"
APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=15

# Analytics - shared secret expected in the `x-analytics-key` header.
ANALYTICS_API_KEY=

# Stellar
STELLAR_NETWORK=testnet
# Soroban RPC endpoint and deployed contract IDs, used by the event
# indexer and the /health check. SOROBAN_RPC_URL takes precedence if both
# are set. Both contract IDs are validated at boot (StrKey contract
# address check); an invalid value stops the app from starting.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployed game contract ID.
LYRICSFLIP_CONTRACT_ID=
# Deployed NFT contract ID. Its `NftMinted` events are indexed alongside
# the game contract's events.
LYRICSFLIP_NFT_CONTRACT_ID=
# Admin account used by POST /admin/songs/sync to call add_card/add_cards.
# Comes from a secret manager in a real deployment; never commit a real value.
SOROBAN_ADMIN_SECRET_KEY=
# Dedicated admin account (public key only) used by POST /admin/songs/sync to
# build *unsigned* add_card/add_cards transactions. It must hold only the
# contract `Admin` role and must NOT be the contract owner; rotate it with
# `set_role`. The API server never signs: the admin's wallet signs the
# returned XDR in the admin UI (LF-219).
# No owner or admin secret key may be present in the API container.
SOROBAN_ADMIN_PUBLIC_KEY=

# Wallet auth (LF-228). Signatures are verified against the SEP-53
# "Stellar Signed Message:\n" prefixed hash. Set to true ONLY in tests to
# also accept legacy raw-byte signatures; never enable in production.
WALLET_AUTH_ALLOW_RAW_SIGNATURES=false
