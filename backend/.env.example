NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://lyricsflip:lyricsflip@localhost:5432/lyricsflip
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# Redis (also used for the throttler's storage and wallet-auth challenges)
REDIS_HOST=localhost
REDIS_PORT=6379
# Full connection URL, used where a single URL is expected instead of host/port.
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_TOKEN_AUDIENCE=localhost:4000
JWT_TOKEN_ISSUER=localhost:4000
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=7776000

# Rate limiting (common/throttler) - global default window/limit.
# RATE_LIMIT_TTL is in milliseconds; /auth/* and answer submission apply
# their own stricter, non-configurable limits.
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=60

# CORS - comma-separated list of allowed origins, or `*` for all.
CORS_ORIGINS=http://localhost:3000

# Email (Mailpit in docker compose: host=localhost, port=1025, no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LyricsFlip <no-reply@lyricsflip.local>"
APP_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=15

# Analytics - shared secret expected in the `x-analytics-key` header.
ANALYTICS_API_KEY=

# Stellar
STELLAR_NETWORK=testnet
# Soroban RPC endpoint and deployed game contract ID, used by the event
# indexer and the /health check. SOROBAN_RPC_URL takes precedence if both
# are set.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
LYRICSFLIP_CONTRACT_ID=
