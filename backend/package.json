{
  "name": "lyricsflip-backend",
  "version": "0.1.0",
  "description": "Backend service for LyricsFlip game",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "seed": "ts-node src/database/seed-songs.ts",
    "seed:unified": "ts-node src/database/seed-unified.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:check": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts src/migrations/DriftCheck --check",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "openapi:export": "ts-node src/utility/export-openapi.ts",
    "issues:sync": "ts-node scripts/sync-issues.ts --file ../ISSUES.md",
    "openapi:generate": "cd ../frontend && npm run generate:api",
    "openapi:check": "npm run openapi:export && npm run openapi:generate && git diff --exit-code -- openapi.json ../frontend/src/services/generated/api.ts || (echo '' && echo 'ERROR: openapi.json or frontend/src/services/generated/api.ts is out of date. Fix: cd backend && npm run openapi:export && npm run openapi:generate && commit both files.' && false)"
    "issues:sync": "ts-node scripts/sync-issues.ts",
    "openapi:generate": "openapi-typescript ../openapi.json -o ../frontend/src/services/generated/openapi.d.ts",
    "openapi:check": "npm run openapi:export && npm run openapi:generate && git diff --exit-code ../openapi.json ../frontend/src/services/generated"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "@stellar/stellar-sdk": "^17.1.0",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.7.6",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.3",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^6.4.24",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "openapi-typescript": "^6.7.6",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": ["<rootDir>/src", "<rootDir>/scripts"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@stellar|@noble|@exodus|uint8array-extras|smol-toml|feaxios)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "scripts/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "testEnvironment": "node",
    "forceExit": true,
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/src/$1"
    }
  },
  "engines": {
    "node": ">=20.18.0 <21"
  }
}
