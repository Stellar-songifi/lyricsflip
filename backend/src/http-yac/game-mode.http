# GAME MODES API
# Real-time play: socket.io namespace /game, connect with auth: { token }.

@baseUrl = http://localhost:3000

### Built-in modes
GET {{baseUrl}}/game-modes

### One mode, its stats and leaderboard
GET {{baseUrl}}/game-modes/classic
GET {{baseUrl}}/game-modes/classic/stats
GET {{baseUrl}}/game-modes/classic/leaderboard

### Player-created modes
GET {{baseUrl}}/game-modes/custom

### Create a custom mode
POST {{baseUrl}}/game-modes/custom
Content-Type: application/json

{
  "name": "Speed round",
  "rules": {
    "timeLimit": 60,
    "pointSystem": { "correct": 10 },
    "powerUpsAllowed": [],
    "minimumPlayers": 2,
    "specialConditions": []
  },
  "isPublic": true
}

### Upvote a custom mode
POST {{baseUrl}}/game-modes/custom/:id/upvote

### Join matchmaking
POST {{baseUrl}}/game-modes/queue
Content-Type: application/json

{
  "modeId": "classic",
  "skill": 1000
}

### Queue status / leave queue
GET {{baseUrl}}/game-modes/queue/status
DELETE {{baseUrl}}/game-modes/queue

### Start a session directly
POST {{baseUrl}}/game-modes/sessions
Content-Type: application/json

{
  "modeId": "classic",
  "playerIds": ["player-1", "player-2"]
}

### Active sessions / end a session
GET {{baseUrl}}/game-modes/sessions/active
POST {{baseUrl}}/game-modes/sessions/:id/end

### Player stats
GET {{baseUrl}}/game-modes/players/:id/stats
