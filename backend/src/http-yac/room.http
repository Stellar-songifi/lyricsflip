# ROOMS API
# Membership events: socket.io namespace /rooms, connect with query { playerId }.

@baseUrl = http://localhost:3000

### List active rooms
GET {{baseUrl}}/rooms?limit=20&page=1

### Create a room
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "name": "Lobby",
  "description": "Main lobby",
  "capacity": 10
}

### Get / update / close a room
GET {{baseUrl}}/rooms/:id

PATCH {{baseUrl}}/rooms/:id
Content-Type: application/json

{
  "name": "Renamed lobby"
}

DELETE {{baseUrl}}/rooms/:id

### Players in a room and count
GET {{baseUrl}}/rooms/:id/players
GET {{baseUrl}}/rooms/:id/player-count

### Join / leave
POST {{baseUrl}}/rooms/:id/join
Content-Type: application/json

{
  "playerId": "uuid"
}

POST {{baseUrl}}/rooms/:id/leave
Content-Type: application/json

{
  "playerId": "uuid"
}

### Player presence
GET {{baseUrl}}/rooms/players/:playerId/current
GET {{baseUrl}}/rooms/players/:playerId/history

PUT {{baseUrl}}/rooms/players/:playerId/status
Content-Type: application/json

{
  "status": "online"
}
