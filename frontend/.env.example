# Backend versioned API root
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# WebSocket URL for real-time multiplayer rooms
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Stellar asset code shown for wagers (Stellar assets use 7 decimals)
NEXT_PUBLIC_WAGER_ASSET_CODE=XLM

# Horizon endpoint used to fetch the connected wallet XLM balance
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL for smart contract invocations
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Shared LyricsFlip testnet contracts (see deployments/testnet.json).
# `npm run env:testnet` rewrites these from that record into .env.local.
NEXT_PUBLIC_LYRICSFLIP_CONTRACT_ID="CBNLE2RKKSFYPI7NPPTQL6OW6K42C46LBDW5TXZKK2OR5LJLUJ32CNGX"

# Deployed LyricsFlip NFT contract ID (starts with C, 56 characters)
NEXT_PUBLIC_LYRICSFLIP_NFT_CONTRACT_ID="CCUREEL7CHI5MHE6H4KHEZYXROG4RKAZYGWQAGPOJZPSDCSII5PNEXNT"
NEXT_PUBLIC_LYRICSFLIP_NFT_CONTRACT_ID=

# Deployed LyricsFlip escrow contract ID (starts with C, 56 characters)
NEXT_PUBLIC_LYRICSFLIP_ESCROW_CONTRACT_ID=

# Wagering UI stays disabled until an escrow contract is configured
NEXT_PUBLIC_WAGERING_ENABLED=false

# Testnet Friendbot endpoint used by first-run funding
NEXT_PUBLIC_STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Optional public URLs
NEXT_PUBLIC_SITE_URL=https://lyricsflip.xyz
NEXT_PUBLIC_APP_URL=https://lyricsflip.xyz
NEXT_PUBLIC_INDEXER_URL=
